echo "🔍 Rodando validações de pre-commit..."

if git diff --staged --quiet; then
  echo "⚠️  Nenhum arquivo no stage."
  exit 0
fi

# Garante a mesma versão do Node usada no CI (ver .nvmrc → v22.23.0).
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "$NVM_DIR/nvm.sh"
  nvm use >/dev/null 2>&1 || nvm use 22.23.0 >/dev/null 2>&1 || true
fi

# Barra console.log / debugger esquecidos no código TS/TSX.
echo "🔎 Checando console.log e debugger..."
STAGED_CODE_FILES=$(git diff --staged --diff-filter=ACM --name-only | grep -E '\.(ts|tsx)$' | grep -v '\.husky/' || true)
if [ -n "$STAGED_CODE_FILES" ]; then
  VIOLATIONS=$(git diff --staged -- $STAGED_CODE_FILES | grep -E "^\+.*console\.(log|error|warn|debug)|^\+.*[^/]debugger" | grep -v "^\+.*//.*console\|^\+.*//.*debugger" || true)
  if [ -n "$VIOLATIONS" ]; then
    echo "❌ Erro: console.log ou debugger encontrado. Remova antes de commitar."
    echo "$VIOLATIONS"
    exit 1
  fi
fi

# lint-staged aplica eslint --fix com as REGRAS DA ÁREA de cada arquivo
# (Node em apps/api + packages, React em apps/web) — ver configuração em
# package.json e eslint.config.mjs.
echo "🔧 Rodando lint-staged (regras por área)..."
pnpm lint-staged || {
  echo "❌ lint-staged falhou. Corrija os problemas acima antes de commitar."
  exit 1
}

echo "✅ Validações de pre-commit OK!"
exit 0
