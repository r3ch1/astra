# Servidor
API_HOST=0.0.0.0
API_PORT=3333

# Motor de cálculo
# Caminho do binário astra-calc. Default: packages/calculator/target/release/astra-calc
# ASTRA_CALC_BIN=/caminho/para/astra-calc
# Diretório dos arquivos .se1 do Swiss Ephemeris (sobe a precisão e habilita Quíron).
# ASTRA_EPHE_PATH=/caminho/para/ephe
# Timeout do cálculo em ms.
ASTRA_CALC_TIMEOUT_MS=10000

# IA / LLM
# Provider ativo:
#   gemini     → Google AI (TEM FREE TIER — bom para começar sem custo)
#   anthropic  → key do Claude direto (pré-pago, exige créditos)
#   mock       → respostas de exemplo, sem IA real nem custo (para dev/UI)
#   (futuro)   → openrouter
LLM_PROVIDER=gemini
# Key do Google AI — https://aistudio.google.com/apikey. NUNCA commitar.
GEMINI_API_KEY=
# Key do Claude — https://console.anthropic.com. NUNCA commitar.
ANTHROPIC_API_KEY=
# Modelo da interpretação individual (cacheável). Se vazio, usa o default do
# provider (gemini-2.5-flash / claude-haiku-4-5). Sobrescreva para subir qualidade.
# ASTRA_LLM_MODEL_INTERPRETATION=
# Teto de tokens por interpretação.
ASTRA_LLM_MAX_TOKENS=1000
# Leitura Completa (síntese do mapa inteiro, não cacheada). Modelo dedicado —
# se vazio, usa o mesmo default do provider; suba para um modelo mais forte
# (ex.: gemini-2.5-pro) sem afetar o cache das interpretações por posição.
# ASTRA_LLM_MODEL_READING=
# Teto de tokens da síntese (texto mais longo que a posição; a leitura em 4
# seções estoura 2000). Gemini 2.5 flash aceita até 8192 de saída.
ASTRA_LLM_READING_MAX_TOKENS=4000
# Retry para erros transitórios do provider (429/503, queda de rede — comuns
# no free tier do Gemini). Backoff exponencial com jitter. ATTEMPTS=1 desliga.
ASTRA_LLM_RETRY_ATTEMPTS=3
ASTRA_LLM_RETRY_BASE_MS=500
ASTRA_LLM_RETRY_MAX_MS=8000
# Diretório do cache de interpretações (arquivos JSON).
# Default: .cache/interpretations na raiz do monorepo.
# ASTRA_CACHE_DIR=
# Diretório dos prompts de IA (interpretation.json fica gitignored; .example é
# versionado). Default: apps/api/prompts.
# ASTRA_PROMPTS_DIR=
