# Servidor
API_HOST=0.0.0.0
API_PORT=3333

# Motor de cálculo
# Caminho do binário astra-calc. Default: packages/calculator/target/release/astra-calc
# ASTRA_CALC_BIN=/caminho/para/astra-calc
# Diretório dos arquivos .se1 do Swiss Ephemeris (sobe a precisão e habilita Quíron).
# ASTRA_EPHE_PATH=/caminho/para/ephe
# Timeout do cálculo em ms.
ASTRA_CALC_TIMEOUT_MS=10000
